<?php require_once __DIR__ . 
"/../config/database.php";
// 如果点击提交
if ($_SERVER['REQUEST_METHOD'] === 'POST') { 
    $program_id = intval($_POST['program_id']);
    // 找到该节目的时间和场地
    $stmt = $db->prepare("SELECT start_time, field 
    FROM programs WHERE id=?"); 
    $stmt->execute([$program_id]); $program = 
    $stmt->fetch(PDO::FETCH_ASSOC); if ($program) {
        $start_time = $program['start_time']; $field 
        = $program['field'];
        // 把该场地在这个时间点之前的节目全部标记为 
        // ended=1
        $update = $db->prepare(" UPDATE programs SET 
            ended=1 WHERE field=? AND start_time <= ?
        "); $update->execute([$field, $start_time]); 
        $message = "已将 {$field} 场地 {$start_time} 
        之前的节目全部覆盖为 ended=1";
    } else {
        $message = "未找到对应节目";
    }
}
// 获取当前未结束的节目（方便选择）
$stmt = $db->query("SELECT id, name, field, 
start_time FROM programs WHERE ended=0 ORDER BY 
start_time ASC"); $programs = 
$stmt->fetchAll(PDO::FETCH_ASSOC); ?> <!DOCTYPE html> 
<html lang="zh"> <head>
    <meta charset="UTF-8"> <title>节目覆盖 
    Override</title>
</head> <body> <h1>覆盖当前节目</h1> <?php if 
    (!empty($message)): ?>
        <p style="color: green;"><?php echo $message; 
        ?></p>
    <?php endif; ?> <form method="post"> <label 
        for="program_id">选择一个节目：</label> 
        <select name="program_id" id="program_id" 
        required>
            <?php foreach ($programs as $p): ?> 
                <option value="<?php echo $p['id']; 
                ?>">
                    <?php echo $p['field']." - 
                    ".$p['name']." 
                    (".$p['start_time'].")"; ?>
                </option> <?php endforeach; ?> 
        </select> <button 
        type="submit">覆盖到此节目</button>
    </form> </body> </html>
