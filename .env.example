# 复制为 .env 并修改（.env 已被 .gitignore 忽略）

# 后台管理密钥（必填，不设置则管理接口返回 503）
# 生成一个：openssl rand -hex 12
ADMIN_TOKEN=change-me

# 后端（API）端口
API_PORT=3000

# 前端端口：配置后 PM2 会单独起一个 vite preview 进程（前后端分离端口）；
# 留空 = 单端口模式，静态页与 API 都由后端进程提供
# WEB_PORT=8080

# SQLite 文件路径（默认 server/data/app.sqlite）
# DB_PATH=/path/to/app.sqlite
